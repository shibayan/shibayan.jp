---
interface Props {
  src: string;
  title?: string;
  className?: string;
}

const {
  src,
  title = 'Presentation slides',
  className = '',
} = Astro.props;
---

<div class:list={[
  'relative w-full aspect-video',
  className,
]}>
  <iframe
    src={src}
    title={title}
    class="absolute inset-0 h-full w-full rounded-lg border-0"
    loading="lazy"
    allowfullscreen
  ></iframe>
</div>
